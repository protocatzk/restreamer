# ---------------------------------------------------------------------------
# Restreamer – Konfiguration
# Kopieren: cp .env.example .env
# ---------------------------------------------------------------------------

TZ=Europe/Berlin

# Host-UID/GID für die Bind-Mounts (config/, logs/, data/).
# Auf diesem Server: 1001. Prüfen mit `id -u` / `id -g`.
PUID=1001
PGID=1001

# Dashboard-Schutz. Leer = kein Login (nur sinnvoll, weil der Port an
# 127.0.0.1 gebunden ist). Bei öffentlichem Zugriff unbedingt setzen.
DASHBOARD_PASSWORD=

# TikTok-Session-Cookie (sessionid). Wird beim Containerstart in eine
# Netscape-cookies.txt für yt-dlp umgewandelt. Ohne Cookie kann TikTok die
# Extraktion verweigern.
TIKTOK_SESSION_ID=
TIKTOK_TARGET_IDC=

# Pfade im Container (normalerweise unverändert lassen)
STREAMERS_FILE=/app/config/streamers.yml
RUNTIME_SETTINGS_FILE=/app/config/settings.yml
LOGS_DIR=/app/logs
COOKIES_FILE=/app/data/cookies.txt

# Hinweis: Werte, die im Dashboard gespeichert werden, landen in
# config/settings.yml und überschreiben die entsprechenden .env-Werte.

# YouTube-RTMP
YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2
YOUTUBE_BACKUP=false

# Dauerhafter YouTube-Ausgang. Live- und Pausenscreen-Quelle werden intern
# als MPEG-TS über Loopback-UDP an einen dauerhaften Ausgabe-ffmpeg gegeben.
# Dadurch bleibt die RTMP-Verbindung bei TikTok-Aussetzern/Quellenwechseln
# bestehen; nur die TikTok-Quelle wird neu eingelesen.
# Ausgabeformat: portrait (720x1280) oder landscape (1280x720). Kann auch im
# Dashboard umgeschaltet werden; live ist dafür ein kurzer Output-Neustart nötig.
RELAY_PORT=19350
# Delay-Puffer zwischen TikTok-Quelle und YouTube-Encoder. Glättet kurze
# Aussetzer, erhöht aber die Latenz um diesen Wert. 0 = kein Puffer.
RELAY_DELAY_SECONDS=30
SOURCE_MIN_RATE_PERCENT=85
OUTPUT_ORIENTATION=portrait
OUTPUT_FPS=25
OUTPUT_STRETCH_PERCENT=10

# Verhalten
OFFLINE_POLL_SECONDS=60
BACKOFF_INITIAL_SECONDS=5
BACKOFF_MAX_SECONDS=300
AUTO_REFRESH_MINUTES=20
STALL_TIMEOUT_SECONDS=30
WATCHDOG_INTERVAL_SECONDS=5
AUTO_START=false
AUTO_REENCODE_FALLBACK=true
RESOLVE_TIMEOUT_SECONDS=90
TERMINATE_TIMEOUT_SECONDS=10
LOG_BUFFER_LINES=500
FFMPEG_LOGLEVEL=info
YTDLP_EXTRA_ARGS=

# Bitrate und Preset des dauerhaften Ausgabe-Encoders (720p30).
# Re-Encode-Fallback für Quellcodecs, die nicht in MPEG-TS passen.
REENCODE_VIDEO_BITRATE=5000k
AUDIO_BITRATE=192k

# Pausenscreen: Wird eingespielt, sobald der TikTok-Stream endet/offline ist
# und der Bot im Watch-Modus weiter pollt. Der Screen wird von ffmpeg aus
# Hintergrundfarbe und Text erzeugt und über denselben internen Relay wie die
# Live-Quelle gesendet – die YouTube-RTMP-Verbindung bleibt bestehen.
# PAUSE_SCREEN_MAX_MINUTES=0 bedeutet unbegrenzt, bis der Streamer zurück ist.
PAUSE_SCREEN_ENABLED=true
PAUSE_SCREEN_TEXT=Stream pausiert
PAUSE_SCREEN_SUBTEXT=Gleich geht's weiter
PAUSE_SCREEN_BACKGROUND=101418
PAUSE_SCREEN_FONT=
PAUSE_SCREEN_MAX_MINUTES=0

# ---------------------------------------------------------------------------
# Feste YouTube-Stream-Keys pro Streamer.
# Die Namen müssen zu `youtube_key_env` in config/streamers.yml passen.
# ---------------------------------------------------------------------------
ALICE_YT_KEY=
BOB_YT_KEY=

# Optional: gemeinsamer YouTube-Key pro Senderliste.
# In config/streamers.yml bei der gewünschten Liste unter
# `youtube_key_env: PLAYLIST_YT_KEY` eintragen. Ist kein gemeinsamer Key
# gesetzt, nutzt jeder Sender seinen eigenen Key.
PLAYLIST_YT_KEY=
