# ---------------------------------------------------------------------------
# py_restream – Konfiguration
# Kopieren: cp .env.example .env
# ---------------------------------------------------------------------------

TZ=Europe/Berlin

# Host-UID/GID für die Bind-Mounts (config/, logs/, data/).
# Auf diesem Server: 1001. Prüfen mit `id -u` / `id -g`.
PUID=1001
PGID=1001

# Dashboard-Schutz. Leer = kein Login (nur sinnvoll, weil der Port an
# 127.0.0.1 gebunden ist). Bei öffentlichem Zugriff unbedingt setzen.
DASHBOARD_PASSWORD=

# TikTok-Session-Cookie (sessionid). Wird beim Containerstart in eine
# Netscape-cookies.txt für yt-dlp umgewandelt. Ohne Cookie kann TikTok die
# Extraktion verweigern.
TIKTOK_SESSION_ID=
TIKTOK_TARGET_IDC=

# Pfade im Container (normalerweise unverändert lassen)
STREAMERS_FILE=/app/config/streamers.yml
RUNTIME_SETTINGS_FILE=/app/config/settings.yml
LOGS_DIR=/app/logs
COOKIES_FILE=/app/data/cookies.txt

# Hinweis: Werte, die im Dashboard gespeichert werden, landen in
# config/settings.yml und überschreiben die entsprechenden .env-Werte.

# YouTube-RTMP
YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2
YOUTUBE_BACKUP=false

# Verhalten
OFFLINE_POLL_SECONDS=60
BACKOFF_INITIAL_SECONDS=5
BACKOFF_MAX_SECONDS=300
AUTO_REFRESH_MINUTES=20
STALL_TIMEOUT_SECONDS=30
WATCHDOG_INTERVAL_SECONDS=5
AUTO_START=false
AUTO_REENCODE_FALLBACK=true
RESOLVE_TIMEOUT_SECONDS=90
TERMINATE_TIMEOUT_SECONDS=10
LOG_BUFFER_LINES=500
FFMPEG_LOGLEVEL=info
YTDLP_EXTRA_ARGS=

# Optional: Re-Encode-Parameter (nur bei video_mode: reencode bzw. HEVC-Quelle)
REENCODE_VIDEO_BITRATE=2500k
AUDIO_BITRATE=160k

# ---------------------------------------------------------------------------
# Feste YouTube-Stream-Keys pro Streamer.
# Die Namen müssen zu `youtube_key_env` in config/streamers.yml passen.
# ---------------------------------------------------------------------------
ALICE_YT_KEY=
BOB_YT_KEY=
